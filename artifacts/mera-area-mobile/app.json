{
  "expo": {
    "name": "Mera Area",
    "slug": "mera-area-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mera-area-mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#f8fbf7",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Mera Area uses your microphone to attach an optional voice note to a local problem."
      }
    },
    "android": {
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
